rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each student can read and write only their own user document
    // AND all of their subcollections (progress, certificates, reports)
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      match /{allSubcollections=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
